# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
.next/
out/
.expo/
*.tsbuildinfo

# Local env & tooling
.env
.env.*
!.env.example
!.env.local.example
.vercel/
.vite/
# .claude/ is local, except shared rules and launch configs
.claude/*
!.claude/rules/
!.claude/launch.json

# Datasets never enter this repo (see README provenance).
# Root-anchored on purpose — a bare "dataset/" would swallow source folders
# like apps/communicate/app/dashboard/dataset/.
/datasets/
/dataset/

# tools/sync keeps blobless clones of the upstream repos here
/tools/sync/.cache/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
coverage/
