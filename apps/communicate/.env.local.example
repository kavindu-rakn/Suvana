# Copy to .env.local and fill in. See README for what each value is.

# Suvana one-domain topology: serve this app under /communicate so the shell
# can proxy it (leave unset to run standalone at the domain root).
NEXT_PUBLIC_BASE_PATH=/communicate

# MongoDB connection string (Atlas free tier works).
MONGODB_URI=

# Auth.js: `npx auth secret` generates one. NEXTAUTH_URL must be the ORIGIN
# ONLY (http://localhost:3000 in dev) — never include the base path: Auth.js
# treats a path here as its own basePath, which mismatches the prefix-stripped
# URLs Next hands the route handler and 400s every auth request. On Vercel,
# leave NEXTAUTH_URL unset entirely — Auth.js v5 trusts the forwarded host,
# which the shell's rewrite passes through.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Comma-separated emails that are always administrators. This is how the first
# admin exists on a fresh database — a listed account is promoted the moment it
# signs in, and the stored role is corrected to match. Remove an email here to
# demote it on its next sign-in. Everyone else defaults to a standard user.
ADMIN_EMAILS=

# Shared secret the speech notebook uses to register its URL
# (POST /api/config/ngrok-url with header x-api-key). With a base path the
# notebook's APP_BASE_URL must include it: https://<shell-domain>/communicate
NGROK_UPDATE_SECRET=

# Cloudinary (stores gloss animations and avatar models).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: path on the notebook server that accepts audio (default /transcribe).
# STT_ENDPOINT_PATH=
