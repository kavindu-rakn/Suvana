# Copy to .env.local to give the built-in assistant model access in development.
#
# NOT prefixed VITE_ on purpose: only that prefix is exposed to client code, so
# an unprefixed name cannot end up in the bundle. This key is read by the
# /api/assistant handler alone (a Vite middleware in dev, a Vercel Edge
# function in production) and never reaches the browser.
#
# Leave it unset and the assistant still answers from Suvana's committed sign
# index — just in fixed phrasing rather than conversationally.
#
# Free key, no credit card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
