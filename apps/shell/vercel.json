{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/learn",
      "destination": "https://suvana-learn.vercel.app/learn"
    },
    {
      "source": "/learn/:path*",
      "destination": "https://suvana-learn.vercel.app/learn/:path*"
    },
    {
      "source": "/communicate",
      "destination": "https://suvana-communicate.vercel.app/communicate"
    },
    {
      "source": "/communicate/:path*",
      "destination": "https://suvana-communicate.vercel.app/communicate/:path*"
    }
  ]
}
