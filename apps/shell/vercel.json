{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "suvana-shell.vercel.app" }],
      "destination": "https://suvana.help/:path*",
      "permanent": true
    },
    { "source": "/communicate/login", "destination": "/login", "permanent": true },
    { "source": "/communicate/register", "destination": "/register", "permanent": true },
    { "source": "/api/login", "destination": "/login", "permanent": true },
    { "source": "/api/register", "destination": "/register", "permanent": true }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/api/login" },
    { "source": "/register", "destination": "/api/register" },
    {
      "source": "/recognize",
      "destination": "https://suvana-production.up.railway.app/?suvana_mount=recognize"
    },
    {
      "source": "/recognize/",
      "destination": "https://suvana-production.up.railway.app/?suvana_mount=recognize"
    },
    {
      "source": "/recognize/:path*",
      "destination": "https://suvana-production.up.railway.app/:path*?suvana_mount=recognize"
    },
    {
      "source": "/learn",
      "destination": "https://suvana-learn.vercel.app/learn"
    },
    {
      "source": "/learn/",
      "destination": "https://suvana-learn.vercel.app/learn/"
    },
    {
      "source": "/learn/:path*",
      "destination": "https://suvana-learn.vercel.app/learn/:path*"
    },
    {
      "source": "/communicate",
      "destination": "https://suvana-communicate.vercel.app/communicate"
    },
    {
      "source": "/communicate/",
      "destination": "https://suvana-communicate.vercel.app/communicate"
    },
    {
      "source": "/communicate/:path*",
      "destination": "https://suvana-communicate.vercel.app/communicate/:path*"
    }
  ]
}
