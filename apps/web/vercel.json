{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/communicate",
      "destination": "https://REPLACE-WITH-COMMUNICATE-DEPLOYMENT.vercel.app/communicate"
    },
    {
      "source": "/communicate/:path*",
      "destination": "https://REPLACE-WITH-COMMUNICATE-DEPLOYMENT.vercel.app/communicate/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(models|references|wasm)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
