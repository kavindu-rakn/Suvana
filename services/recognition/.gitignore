# ==============================================================================
# Sinhala Sign Language Recognition - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.manifest
*.spec

# ------------------------------------------------------------------------------
# Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Logs & TensorBoard
# ------------------------------------------------------------------------------
*.log
logs/
*.tfevents.*
events.out.tfevents.*
build_labels.log

# ------------------------------------------------------------------------------
# WebApp TTS Audio Cache & Dynamic Cache
# ------------------------------------------------------------------------------
webapp/tts_cache/*
!webapp/tts_cache/.gitkeep
tts_cache/
.cache/

# ------------------------------------------------------------------------------
# Datasets & Extracted Features (Landmarks / Sequences)
# ------------------------------------------------------------------------------
# A bare `data/` excluded the whole tree at every level, which also swallowed
# the two small derived files below -- so they never arrived with a clone or
# reached the Docker image, and the service came up with no label map at all.
# Anchored patterns instead, so git can still descend into those directories.
/data/*
!/data/processed/
/data/processed/*
/webapp/data/*
dataset/
datasets/
*.npy
*.npz
*.parquet
*.feather
*.h5.temp

# Committed on purpose (~380 KB): without labels.npy every prediction reads
# Gesture_0...Gesture_170, and without sinhala_labels.json there is no Sinhala
# script and the assistant on that page reports zero signs. Both are derived
# from Lahiru's processed dataset and must not be regenerated from the Kaggle
# corpus -- the label order has to match the trained model's output indices
# exactly. These negations must stay *after* `*.npy`: last match wins.
!/data/processed/labels.npy
!/data/processed/metadata.json
!/webapp/data/sinhala_labels.json

# ------------------------------------------------------------------------------
# Model Weights & Training Checkpoints
# Note: GitHub hard file size limit is 100MB.
# If you want to track pre-trained models via Git LFS, configure git lfs track "*.h5"
# ------------------------------------------------------------------------------
checkpoints/
*.ckpt
*.pt
*.pth
*.onnx
*.tflite
# Uncomment below if you store models externally / on HuggingFace / Google Drive:
# models/saved_models/*.h5

# ------------------------------------------------------------------------------
# Jupyter Notebooks
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

# ------------------------------------------------------------------------------
# Testing & Code Quality
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# IDEs, Editors & Developer Tools
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/
.qodo/
.cursor/

# ------------------------------------------------------------------------------
# OS-Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.json

# ------------------------------------------------------------------------------
# Distribution & Build
# ------------------------------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
# ------------------------------------------------------------------------------