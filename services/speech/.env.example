# All optional — the service runs with defaults matching the Colab notebook.

# Shared secret required on POST /translate (header x-api-key). The notebook
# ran open behind an unguessable ngrok URL; a persistent host is guessable,
# so SET THIS in any real deployment. Give the same value to the communicate
# app as STT_API_KEY so its /api/stt proxy can authenticate.
TRANSLATE_API_KEY=

# Trained prosody emotion classifier from EmotionClassifier.ipynb (ask
# Lithira for the artifact). Absent -> English wav2vec2 fallback is used.
EMOTION_CLF_PATH=emotion_clf.joblib

# Self-registration with the communicate app on startup (all three or none):
PUBLIC_URL=
APP_CONFIG_URL=
NGROK_UPDATE_SECRET=

# Model overrides — defaults are the notebook's.
# WHISPER_BASE_MODEL=openai/whisper-medium
# WHISPER_ADAPTER_ID=SPEAK-ASR/whisper-si-exp-10-medium-all

# CORS_ORIGINS=*        comma-separated list to restrict
# PORT=7860
